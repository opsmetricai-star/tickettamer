# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (server only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Selar checkout links (public URLs)
NEXT_PUBLIC_SELAR_STARTER_URL=https://selar.com/47plan?currency=USD
NEXT_PUBLIC_SELAR_GROWTH_URL=https://selar.com/57plan?currency=USD
NEXT_PUBLIC_SELAR_SCALE_URL=https://selar.com/97plan?currency=USD

# Shared secret that must be sent as ?secret= or x-webhook-secret to /api/billing/webhook
BILLING_WEBHOOK_SECRET=
# Comma-separated emails allowed to activate plans from /app/admin
ADMIN_EMAILS=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
